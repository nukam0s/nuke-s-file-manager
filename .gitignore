# ---------------------------------------------------------------------------
# Nuke File Manager — repository hygiene
# Rule of thumb: only hand-written source, docs and configuration belong in git.
# Everything generated, downloaded or machine-specific stays out.
# ---------------------------------------------------------------------------

# --- Dependencies -----------------------------------------------------------
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Frontend build output --------------------------------------------------
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# --- Packaged / release artifacts ------------------------------------------
# electron-builder output (portable .exe + win-unpacked tree)
release/
out/

# --- Portable / SEA build artifacts ---------------------------------------
# Whole folder ignored: it only ever holds compiled output.
build/
# Belt-and-braces: if someone force-adds build/, these are still refused.
build/*.exe
build/*.blob
build/main.cjs
build/server.cjs
build/sea-config.json
build/sea-prep.blob

# Generated at build time by scripts/bundle-server.mjs — it inlines the whole
# dist/ bundle, so it is a build artifact, never source.
server/assets.generated.js

# --- Tauri / Rust -----------------------------------------------------------
src-tauri/target/
src-tauri/gen/
**/*.rs.bk

# --- Logs, coverage, test output -------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/
test-results/
playwright-report/

# --- Environment files (never commit real values) ---------------------------
.env
.env.*
*.local
!.env.example
!.env.sample

# --- Certificates & private keys (never commit) ----------------------------
*.pem
*.pfx
*.p12
*.key
*.crt
*.cer
*.der
*.jks
*.keystore

# --- Secrets / local vaults -------------------------------------------------
# Remote-connection vault lives in %APPDATA%, but keep it out if a dev copies
# it into the working tree.
vault.json
vault.key

# --- Editor / IDE -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- OS metadata ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
